DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/platform_admin_v2
SECRET_KEY=change-me-when-pushed-to-prod
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["*"]
ACCESS_TOKEN_EXPIRE_MINUTES=20
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
OTP_EXPIRY_MINUTES=10
OTP_MAX_REQUESTS_PER_WINDOW=3
OTP_THROTTLE_WINDOW_MINUTES=15
PASSWORD_HISTORY_DEPTH=3
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_FILE=logs/app_logs/platform-admin.log
TRACING_ENABLED=false
TRACING_OTLP_ENDPOINT=
TRACING_LOG_TO_FILE=true
TRACING_LOG_FILE=logs/trace_logs/traces.log
TRACING_LOG_TO_CONSOLE=false

# Exports (BRD §6.6: reason, 24h single-user link, max 100k rows/file)
EXPORT_DIR=exports
EXPORT_LINK_TTL_HOURS=24
EXPORT_MAX_ROWS=100000
